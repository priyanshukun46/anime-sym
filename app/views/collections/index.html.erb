<% content_for :title, "Curated Anime Collections - Anime Sym" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
  
  <div class="relative rounded-3xl bg-gradient-to-r from-zinc-900 via-purple-950/20 to-zinc-900 border border-zinc-800/80 p-8 sm:p-10 overflow-hidden shadow-2xl">
    <div class="relative z-10 max-w-2xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-900/40 border border-purple-500/30 text-xs font-bold text-purple-300">
        <%= anime_sym_icon("sparkles", class: "w-3.5 h-3.5") %>
        <span>Curator's Editions</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
        Editorial Collections
      </h1>
      <p class="text-sm text-zinc-400 leading-relaxed">
        Thematic anthologies and hand-selected series, organized by tone, visual craftsmanship, and emotional impact.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <% @collections.each do |collection| %>
      <div class="group relative rounded-3xl bg-zinc-900/70 border border-zinc-800 hover:border-purple-500/50 p-6 sm:p-8 flex flex-col justify-between overflow-hidden shadow-xl hover:shadow-purple-900/20 transition-all duration-300">
        
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-purple-950/60 border border-purple-500/40 text-purple-300">
              <%= collection.badge %>
            </span>
            <span class="text-xs text-zinc-400"><%= collection.animes.count %> titles</span>
          </div>

          <h3 class="text-2xl font-black text-white group-hover:text-purple-300 transition-colors">
            <%= link_to collection.title, collection_path(collection) %>
          </h3>

          <p class="text-sm text-zinc-400 leading-relaxed">
            <%= collection.curator_note %>
          </p>
        </div>

        <div class="mt-8 pt-4 border-t border-zinc-800/80 flex items-center justify-between">
          <div class="flex items-center -space-x-3 overflow-hidden">
            <% collection.animes.first(4).each do |a| %>
              <img src="<%= a.poster_url %>" 
                   alt="<%= a.title %>" 
                   class="w-12 h-16 object-cover rounded-lg border-2 border-zinc-900 shadow-md">
            <% end %>
          </div>

          <%= link_to collection_path(collection), class: "inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold transition-all shadow-lg shadow-purple-600/30" do %>
            <span>View Lineup</span>
            <%= anime_sym_icon("chevron-right", class: "w-4 h-4") %>
          <% end %>
        </div>

      </div>
    <% end %>
  </div>

</div>
