<% content_for :title, "Create Account - Anime Sym" %>

<div class="min-h-[calc(100vh-16rem)] flex items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8 bg-zinc-900/70 border border-zinc-800 rounded-3xl p-8 sm:p-10 shadow-2xl backdrop-blur-xl relative overflow-hidden">
    
    <!-- Ambient Blur Background -->
    <div class="absolute -top-12 -right-12 w-40 h-40 bg-purple-600/10 rounded-full blur-2xl pointer-events-none"></div>

    <!-- Branded Header with Logo -->
    <div class="text-center space-y-4">
      <%= link_to root_path, class: "inline-block group", aria: { label: "Anime Sym Homepage" } do %>
        <div class="w-16 h-16 rounded-2xl bg-zinc-950 border border-purple-500/40 p-2 shadow-xl shadow-purple-600/20 group-hover:scale-105 transition-transform flex items-center justify-center mx-auto">
          <%= image_tag "logo.svg", alt: "Anime Sym Logo", class: "w-full h-full object-contain" %>
        </div>
      <% end %>

      <div>
        <h1 class="text-2xl font-black text-white tracking-tight">
          Join <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-400">Anime Sym</span>
        </h1>
        <p class="text-xs text-zinc-400 mt-1">
          Synchronize your anime watchlist across all your devices
        </p>
      </div>
    </div>

    <!-- Signup Form -->
    <%= form_with url: signup_path, method: :post, class: "mt-8 space-y-5" do |f| %>
      <div class="space-y-4">
        <div>
          <label for="username" class="block text-xs font-bold uppercase tracking-wider text-zinc-300 mb-1.5">Username</label>
          <%= f.text_field :username, 
                id: "username",
                required: true, 
                placeholder: "otaku_master",
                class: "w-full px-4 py-3 text-sm bg-zinc-950 border border-zinc-800 focus:border-purple-500 rounded-xl text-zinc-100 placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-purple-500/30 transition-all" %>
        </div>

        <div>
          <label for="signup_email" class="block text-xs font-bold uppercase tracking-wider text-zinc-300 mb-1.5">Email address</label>
          <%= f.email_field :email, 
                id: "signup_email",
                required: true, 
                autocomplete: "email",
                placeholder: "you@example.com",
                class: "w-full px-4 py-3 text-sm bg-zinc-950 border border-zinc-800 focus:border-purple-500 rounded-xl text-zinc-100 placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-purple-500/30 transition-all" %>
        </div>

        <div>
          <label for="signup_password" class="block text-xs font-bold uppercase tracking-wider text-zinc-300 mb-1.5">Password</label>
          <%= f.password_field :password, 
                id: "signup_password",
                required: true, 
                autocomplete: "new-password",
                placeholder: "At least 6 characters",
                class: "w-full px-4 py-3 text-sm bg-zinc-950 border border-zinc-800 focus:border-purple-500 rounded-xl text-zinc-100 placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-purple-500/30 transition-all" %>
        </div>
      </div>

      <div>
        <%= f.submit "Create Free Account", class: "w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold text-sm shadow-xl shadow-purple-600/30 transition-all cursor-pointer" %>
      </div>
    <% end %>

    <!-- Footer Switcher -->
    <div class="text-center pt-4 border-t border-zinc-800/80 text-xs text-zinc-400">
      Already have an account? 
      <%= link_to "Sign in here", login_path, class: "font-bold text-purple-400 hover:text-purple-300 ml-1" %>
    </div>

  </div>
</div>
