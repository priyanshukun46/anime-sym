<% content_for :title, "About & Official Streaming Policy - Anime Sym" %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
  
  <!-- Page Header -->
  <div class="text-center space-y-4">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-purple-950/60 border border-purple-500/40 text-xs font-bold text-purple-300">
      <%= anime_sym_icon("check", class: "w-4 h-4 text-emerald-400") %>
      <span>Strict Official Source Policy: Muse Asia & Muse India Only</span>
    </div>
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight">
      About <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-400">Anime Sym</span>
    </h1>
    <p class="text-base text-zinc-400 max-w-2xl mx-auto leading-relaxed">
      A legal anime discovery and streaming portal built to connect viewers directly with authorized, high-definition anime releases published by official channel partners.
    </p>
  </div>

  <!-- Key Pillars Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="p-6 rounded-2xl bg-zinc-900/60 border border-zinc-800 space-y-3">
      <div class="w-10 h-10 rounded-xl bg-purple-900/40 border border-purple-500/30 flex items-center justify-center text-purple-400">
        <%= anime_sym_icon("check", class: "w-5 h-5 text-emerald-400") %>
      </div>
      <h3 class="text-lg font-bold text-white">Strict Source Verification</h3>
      <p class="text-xs text-zinc-400 leading-relaxed">
        Every single episode indexed on Anime Sym is verified against the official YouTube Channel IDs for <strong>Muse Asia</strong> (<code>UCGbshtvS9t-8CW11W7TooQg</code>) and <strong>Muse India</strong> (<code>UCYYhAzgWuxPauRXdPpLAX3Q</code>). Unverified reuploads and third-party mirrors are strictly excluded.
      </p>
    </div>

    <div class="p-6 rounded-2xl bg-zinc-900/60 border border-zinc-800 space-y-3">
      <div class="w-10 h-10 rounded-xl bg-purple-900/40 border border-purple-500/30 flex items-center justify-center text-purple-400">
        <%= anime_sym_icon("tv", class: "w-5 h-5") %>
      </div>
      <h3 class="text-lg font-bold text-white">Seamless In-App Player</h3>
      <p class="text-xs text-zinc-400 leading-relaxed">
        Episodes stream inside Anime Sym through YouTube's official NOCookie iframe embed with full theater mode, episode selector sidebars, and next/previous controls—without opening external tabs.
      </p>
    </div>
  </div>

  <!-- Official Channel Partners -->
  <div class="rounded-3xl bg-zinc-900/50 border border-zinc-800 p-8 space-y-6">
    <h2 class="text-xl font-bold text-white flex items-center gap-2">
      <%= anime_sym_icon("sparkles", class: "w-5 h-5 text-purple-400") %>
      <span>Authorized Channel Specifications</span>
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="p-5 rounded-2xl bg-zinc-950/80 border border-zinc-800 space-y-2">
        <div class="flex items-center justify-between">
          <h4 class="font-bold text-white text-base">Muse Asia</h4>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950 text-emerald-400 border border-emerald-500/30">Verified Licensor</span>
        </div>
        <p class="text-xs text-zinc-400">Official YouTube Channel for Southeast Asian anime distribution.</p>
        <p class="text-[11px] font-mono text-purple-400 truncate">ID: UCGbshtvS9t-8CW11W7TooQg</p>
        <div class="pt-2">
          <%= link_to "https://www.youtube.com/@MuseAsia", "https://www.youtube.com/@MuseAsia", target: "_blank", rel: "noopener noreferrer", class: "text-xs font-semibold text-purple-400 hover:text-purple-300 flex items-center gap-1" %>
        </div>
      </div>

      <div class="p-5 rounded-2xl bg-zinc-950/80 border border-zinc-800 space-y-2">
        <div class="flex items-center justify-between">
          <h4 class="font-bold text-white text-base">Muse India</h4>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950 text-emerald-400 border border-emerald-500/30">Verified Licensor</span>
        </div>
        <p class="text-xs text-zinc-400">Official YouTube Channel for South Asian anime distribution and regional dubs.</p>
        <p class="text-[11px] font-mono text-purple-400 truncate">ID: UCYYhAzgWuxPauRXdPpLAX3Q</p>
        <div class="pt-2">
          <%= link_to "https://www.youtube.com/@MuseIndiaChannel", "https://www.youtube.com/@MuseIndiaChannel", target: "_blank", rel: "noopener noreferrer", class: "text-xs font-semibold text-purple-400 hover:text-purple-300 flex items-center gap-1" %>
        </div>
      </div>
    </div>
  </div>

  <!-- Copyright Disclaimer -->
  <div class="rounded-3xl bg-zinc-900/30 border border-zinc-800 p-8 space-y-4 text-xs text-zinc-300 leading-relaxed">
    <h3 class="text-base font-bold text-white">Compliance & Copyright Respect</h3>
    <p>
      Anime Sym does not download, store, host, convert, or distribute copyrighted video files. All media is rendered directly from YouTube's official servers via embed permissions configured by the copyright owners.
    </p>
    <p>
      If an episode cannot be verified as belonging to Muse Asia or Muse India, it is excluded from our catalog automatically.
    </p>
  </div>

</div>
