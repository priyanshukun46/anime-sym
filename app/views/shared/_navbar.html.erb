<header class="fixed top-0 left-0 right-0 z-40 glass-nav transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20 gap-4">
      
      <!-- Brand Logo -->
      <%= link_to root_path, class: "flex items-center gap-3 group shrink-0" do %>
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-purple-600 via-indigo-600 to-pink-500 p-0.5 shadow-lg shadow-purple-600/30 group-hover:shadow-purple-500/50 transition-all duration-300 transform group-hover:scale-105">
          <div class="w-full h-full bg-zinc-950 rounded-[10px] flex items-center justify-center">
            <svg class="w-5 h-5 text-purple-400 group-hover:text-purple-300 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4m14.5 6.5L5.5 5.5" />
            </svg>
          </div>
        </div>
        <div>
          <span class="text-xl md:text-2xl font-black tracking-tight text-white flex items-center gap-1.5">
            ANIME<span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-400">SYM</span>
          </span>
          <span class="hidden sm:block text-[10px] font-semibold tracking-widest text-zinc-400 uppercase -mt-1">
            Official Streaming
          </span>
        </div>
      <% end %>

      <!-- Desktop Nav Links -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2">
        <%= link_to root_path, class: "px-3.5 py-2 rounded-lg text-sm font-medium transition-colors #{current_page?(root_path) ? 'text-white bg-purple-500/15 border border-purple-500/30 font-semibold' : 'text-zinc-300 hover:text-white hover:bg-zinc-800/60'}" do %>
          Home
        <% end %>
        <%= link_to catalog_path, class: "px-3.5 py-2 rounded-lg text-sm font-medium transition-colors #{current_page?(catalog_path) ? 'text-white bg-purple-500/15 border border-purple-500/30 font-semibold' : 'text-zinc-300 hover:text-white hover:bg-zinc-800/60'}" do %>
          Catalog
        <% end %>
        <%= link_to genres_path, class: "px-3.5 py-2 rounded-lg text-sm font-medium transition-colors #{current_page?(genres_path) ? 'text-white bg-purple-500/15 border border-purple-500/30 font-semibold' : 'text-zinc-300 hover:text-white hover:bg-zinc-800/60'}" do %>
          Genres
        <% end %>
        <%= link_to collections_path, class: "px-3.5 py-2 rounded-lg text-sm font-medium transition-colors #{current_page?(collections_path) ? 'text-white bg-purple-500/15 border border-purple-500/30 font-semibold' : 'text-zinc-300 hover:text-white hover:bg-zinc-800/60'}" do %>
          Collections
        <% end %>
      </nav>

      <!-- Live Search Bar with Debounce -->
      <div class="relative flex-1 max-w-xs lg:max-w-sm hidden sm:block" data-controller="search">
        <%= form_with url: catalog_path, method: :get, class: "relative", local: true do |f| %>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-zinc-400">
              <%= anime_sym_icon("search", class: "w-4 h-4") %>
            </span>
            <%= f.text_field :q, 
                  value: params[:q],
                  placeholder: "Search titles, characters...", 
                  autocomplete: "off",
                  class: "w-full pl-9 pr-4 py-2 text-xs md:text-sm bg-zinc-900/90 border border-zinc-800 focus:border-purple-500 rounded-full text-zinc-100 placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-purple-500/30 transition-all",
                  data: {
                    search_target: "input",
                    action: "input->search#onInput keydown->search#onKeydown"
                  } %>
          </div>
        <% end %>

        <!-- Live Search Suggestions Dropdown -->
        <div data-search-target="dropdown" class="hidden absolute top-full left-0 right-0 mt-2 bg-zinc-900/95 backdrop-blur-xl border border-zinc-800 rounded-2xl shadow-2xl overflow-hidden z-50">
          <div data-search-target="results" class="p-2 space-y-1">
            <!-- Rendered by Stimulus & search_suggestions -->
          </div>
        </div>
      </div>

      <!-- Action: Watchlist & Mobile Hamburger -->
      <div class="flex items-center gap-3 shrink-0">
        <!-- Watchlist Button with Live Turbo Counter -->
        <%= link_to watchlist_path, class: "relative p-2.5 rounded-xl bg-zinc-900/80 hover:bg-zinc-800 border border-zinc-800 hover:border-purple-500/50 text-zinc-300 hover:text-white transition-all group", id: "navbar_watchlist_btn", title: "My Watchlist" do %>
          <%= anime_sym_icon("bookmark", class: "w-5 h-5 group-hover:scale-110 transition-transform text-purple-400") %>
          <span id="watchlist_badge" class="absolute -top-1 -right-1 px-1.5 py-0.5 text-[10px] font-bold rounded-full bg-gradient-to-r from-purple-600 to-pink-600 text-white shadow-md">
            <%= watchlist_count %>
          </span>
        <% end %>

        <!-- Mobile Menu Hamburger Trigger -->
        <button type="button" 
                class="md:hidden p-2.5 rounded-xl bg-zinc-900/80 hover:bg-zinc-800 border border-zinc-800 text-zinc-300 hover:text-white transition-all"
                data-action="click->mobile-menu#toggle"
                aria-label="Toggle navigation menu">
          <%= anime_sym_icon("menu", class: "w-5 h-5") %>
        </button>
      </div>

    </div>
  </div>
</header>
