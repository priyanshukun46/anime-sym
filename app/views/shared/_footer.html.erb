<footer class="mt-24 border-t border-zinc-800/80 bg-zinc-950/90 relative overflow-hidden">
  <!-- Subtle Ambient Glow -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[600px] h-48 bg-purple-600/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      
      <!-- Brand & Mission Column -->
      <div class="md:col-span-1 space-y-4">
        <%= link_to root_path, class: "flex items-center gap-2.5" do %>
          <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-purple-600 to-pink-500 p-0.5">
            <div class="w-full h-full bg-zinc-950 rounded-[6px] flex items-center justify-center">
              <svg class="w-4 h-4 text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4m14.5 6.5L5.5 5.5" />
              </svg>
            </div>
          </div>
          <span class="text-xl font-black text-white">ANIME<span class="text-purple-400">SYM</span></span>
        <% end %>
        <p class="text-xs text-zinc-400 leading-relaxed">
          The curated anime discovery & streaming hub. Synchronizing viewers with official, authorized YouTube streaming broadcasts and publisher channels.
        </p>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-purple-950/40 border border-purple-500/20 text-[11px] text-purple-300">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          100% Legal & Authorized Streams Only
        </div>
      </div>

      <!-- Quick Exploration Links -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-zinc-300 mb-4">Discover</h4>
        <ul class="space-y-2.5 text-xs text-zinc-400">
          <li><%= link_to "Anime Catalog", catalog_path, class: "hover:text-purple-400 transition-colors" %></li>
          <li><%= link_to "Trending Releases", catalog_path(sort: "trending"), class: "hover:text-purple-400 transition-colors" %></li>
          <li><%= link_to "Top Rated All-Time", catalog_path(sort: "rating"), class: "hover:text-purple-400 transition-colors" %></li>
          <li><%= link_to "Curated Collections", collections_path, class: "hover:text-purple-400 transition-colors" %></li>
          <li><%= link_to "Genre Directory", genres_path, class: "hover:text-purple-400 transition-colors" %></li>
        </ul>
      </div>

      <!-- Curated Collections Links -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-zinc-300 mb-4">Curations</h4>
        <ul class="space-y-2.5 text-xs text-zinc-400">
          <li><%= link_to "Masterpiece Tier", collection_path("masterpiece-tier-must-watch"), class: "hover:text-purple-400 transition-colors" %></li>
          <li><%= link_to "Supernatural & Action", collection_path("supernatural-action-powerhouses"), class: "hover:text-purple-400 transition-colors" %></li>
          <li><%= link_to "Dark Fantasy Thrillers", collection_path("dark-fantasy-psychological"), class: "hover:text-purple-400 transition-colors" %></li>
          <li><%= link_to "Cozy Expeditions", collection_path("cozy-expeditions-wholesome-bonds"), class: "hover:text-purple-400 transition-colors" %></li>
          <li><%= link_to "My Personal Watchlist", watchlist_path, class: "hover:text-purple-400 transition-colors" %></li>
        </ul>
      </div>

      <!-- Legal & Architecture -->
      <div class="space-y-4">
        <h4 class="text-xs font-bold uppercase tracking-wider text-zinc-300">Legal & Transparency</h4>
        <p class="text-xs text-zinc-400 leading-relaxed">
          Anime Sym does not host or distribute copyrighted video files on our servers. All video streams are embedded via official YouTube players and authorized licensed channels.
        </p>
        <div class="pt-2 flex items-center gap-3">
          <%= link_to about_path, class: "text-xs font-semibold text-purple-400 hover:text-purple-300 flex items-center gap-1" do %>
            <span>Read Legal Disclaimers</span>
            <%= anime_sym_icon("external-link", class: "w-3 h-3") %>
          <% end %>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-zinc-900 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-400">
      <p>&copy; <%= Time.current.year %> Anime Sym. All rights reserved. Created with Ruby on Rails 8, Hotwire & Tailwind CSS.</p>
      <div class="flex items-center gap-4">
        <%= link_to "Catalog", catalog_path, class: "hover:text-zinc-200" %>
        <span>•</span>
        <%= link_to "Watchlist", watchlist_path, class: "hover:text-zinc-200" %>
        <span>•</span>
        <%= link_to "About", about_path, class: "hover:text-zinc-200" %>
      </div>
    </div>
  </div>
</footer>
