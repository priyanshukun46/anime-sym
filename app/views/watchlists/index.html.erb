<% content_for :title, "My Watchlist - Anime Sym" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
  
  <!-- Header -->
  <div class="relative rounded-3xl bg-gradient-to-r from-zinc-900 via-purple-950/20 to-zinc-900 border border-zinc-800/80 p-8 sm:p-10 overflow-hidden shadow-2xl">
    <div class="relative z-10 max-w-2xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-900/40 border border-purple-500/30 text-xs font-bold text-purple-300">
        <%= anime_sym_icon("bookmark", class: "w-3.5 h-3.5") %>
        <span>Personal Library</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
        My Watchlist
      </h1>
      <p class="text-sm text-zinc-400 leading-relaxed">
        Your saved anime series, ready for instant playback. Track your progress across seasons and episodes.
      </p>
    </div>
  </div>

  <!-- Watchlist Content Grid -->
  <% if @watchlist_animes.any? %>
    <div class="space-y-4">
      <div class="flex items-center justify-between text-xs text-zinc-400 pb-2 border-b border-zinc-800">
        <span>Saved titles: <strong class="text-white"><%= @watchlist_animes.count %></strong></span>
        <span>Stored securely in your local session</span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 gap-4 md:gap-6">
        <% @watchlist_animes.each do |anime| %>
          <div id="watchlist_card_<%= anime.id %>" class="relative group">
            <%= render "shared/anime_card", anime: anime %>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="py-20 text-center rounded-3xl bg-zinc-900/40 border border-zinc-800/80 p-8 space-y-4">
      <div class="w-16 h-16 rounded-full bg-purple-950/50 border border-purple-500/30 flex items-center justify-center mx-auto text-purple-400">
        <%= anime_sym_icon("bookmark", class: "w-8 h-8") %>
      </div>
      <h3 class="text-xl font-bold text-white">Your watchlist is currently empty</h3>
      <p class="text-sm text-zinc-400 max-w-md mx-auto">
        Bookmark series while browsing the catalog to build your custom streaming lineup.
      </p>
      <div class="pt-3">
        <%= link_to "Explore Anime Catalog", catalog_path, class: "px-6 py-3 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-bold text-sm shadow-xl shadow-purple-600/30 transition-all inline-block" %>
      </div>
    </div>
  <% end %>

</div>
