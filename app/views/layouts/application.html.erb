<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "Anime Sym - Stream Official Anime Online" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Discover and stream anime legally with Anime Sym. Official licensed YouTube streams, curated collections, episode guides, and real-time community reactions.">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Anime Sym">
    <meta name="theme-color" content="#09090b">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- Fonts: Inter / Display Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">

    <!-- Stylesheets: Tailwind CSS Compiled -->
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-[#09090b] text-zinc-100 font-['Plus_Jakarta_Sans',sans-serif] min-h-screen flex flex-col selection:bg-purple-600 selection:text-white antialiased"
        data-controller="mobile-menu trailer-modal">

    <!-- Sticky Navigation -->
    <%= render "shared/navbar" %>

    <!-- Mobile Slide-out Drawer -->
    <%= render "shared/mobile_menu" %>

    <!-- Global Trailer Lightbox Modal -->
    <%= render "shared/trailer_modal" %>

    <!-- Global Flash Notification Messages -->
    <%= render "shared/flash" %>

    <!-- Main Content (Full Bleed Support) -->
    <main class="flex-grow pt-16 md:pt-20">
      <%= yield %>
    </main>

    <!-- Footer -->
    <%= render "shared/footer" %>
  </body>
</html>
