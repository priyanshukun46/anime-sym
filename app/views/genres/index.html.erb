<% content_for :title, "Anime Genres Directory - Anime Sym" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
  
  <div class="relative rounded-3xl bg-gradient-to-r from-zinc-900 via-purple-950/20 to-zinc-900 border border-zinc-800/80 p-8 sm:p-10 overflow-hidden shadow-2xl">
    <div class="relative z-10 max-w-2xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-900/40 border border-purple-500/30 text-xs font-bold text-purple-300">
        <%= anime_sym_icon("filter", class: "w-3.5 h-3.5") %>
        <span>Taxonomy Directory</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
        Browse by Genre
      </h1>
      <p class="text-sm text-zinc-400 leading-relaxed">
        From adrenaline-fueled shonen battles to contemplative fantasy journeys, discover anime tailored to your taste.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @genres.each do |genre| %>
      <div class="group relative rounded-2xl bg-zinc-900/60 border border-zinc-800 hover:border-purple-500/50 p-6 flex flex-col justify-between overflow-hidden shadow-lg hover:shadow-purple-900/20 transition-all duration-300">
        
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <h3 class="text-xl font-bold text-white group-hover:text-purple-300 transition-colors">
              <%= link_to genre.name, genre_path(genre) %>
            </h3>
            <span class="px-2.5 py-1 rounded-full bg-purple-950/60 border border-purple-500/30 text-xs font-bold text-purple-300">
              <%= genre.animes.count %> titles
            </span>
          </div>

          <p class="text-xs text-zinc-400 leading-relaxed">
            <%= genre.description %>
          </p>
        </div>

        <!-- Poster Previews -->
        <div class="mt-6 pt-4 border-t border-zinc-800/80 flex items-center justify-between">
          <div class="flex items-center -space-x-2">
            <% genre.animes.first(3).each do |a| %>
              <img src="<%= a.poster_url %>" 
                   alt="<%= a.title %>" 
                   class="w-8 h-11 object-cover rounded-md border border-zinc-900 shadow">
            <% end %>
          </div>

          <%= link_to genre_path(genre), class: "inline-flex items-center gap-1 text-xs font-bold text-purple-400 group-hover:text-purple-300 group-hover:translate-x-1 transition-all" do %>
            <span>Explore <%= genre.name %></span>
            <%= anime_sym_icon("chevron-right", class: "w-3.5 h-3.5") %>
          <% end %>
        </div>

      </div>
    <% end %>
  </div>

</div>
